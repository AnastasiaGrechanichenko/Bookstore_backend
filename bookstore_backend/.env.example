# --------------------- База данных ---------------------
# Асинхронное подключение (для основных эндпоинтов FastAPI)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/postgres

# Синхронное подключение (для админ-панели SQLAdmin)
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/postgres

# --------------------- Безопасность ---------------------
# Секретный ключ для подписи сессий и CSRF-защиты админки
# Сгенерируйте через: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-secret-key-here-generate-this-with-the-command-above

# --------------------- Админ-панель ---------------------
# Пароль для входа в админку (логин: admin)
ADMIN_PASSWORD=admin123